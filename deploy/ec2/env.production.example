# Copy on EC2: cp deploy/ec2/env.production.example .env
# Then set the three secrets below (chmod 600 .env). Do not commit .env.
#
# DNS: Route 53 A record for magnottarouting.com -> Elastic IP
# GitHub Actions: EC2_HOST=magnottarouting.com (or Elastic IP), EC2_USER=ec2-user

ROUTING_DOMAIN=magnottarouting.com
APP_URL=https://magnottarouting.com

NODE_ENV=production
PORT=3000
HOST_PORT=3000

TRUST_PROXY=true
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true

# --- Set on the server only (never commit real values) ---
GOOGLE_MAPS_API_KEY=
ACCESS_CODE=
# Optional: gate public /api/health detail from the internet
HEALTH_CHECK_TOKEN=

# Optional rate limit overrides (defaults are usually fine)
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_EXPENSIVE_MAX=60
# RATE_LIMIT_UPLOAD_MAX=5
