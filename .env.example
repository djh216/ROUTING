# GOOGLE_MAPS_API_KEY: Optional. Used for Distance Matrix API (traffic-aware ETAs) and Directions API (road-following route geometry).
# If not provided, the application automatically uses straight-line distance calculations at 45 mph.
# Production: restrict key to EC2 Elastic IP in Google Cloud Console (never commit this value).
GOOGLE_MAPS_API_KEY=

# ACCESS_CODE: When set, the app requires this code (share link ?code=... or login form). Leave empty for open local dev.
ACCESS_CODE=

# --- Production EC2 (magnottarouting.com) ---
# On the server use the full template: deploy/ec2/env.production.example
# ROUTING_DOMAIN=magnottarouting.com
# APP_URL=https://magnottarouting.com
# TRUST_PROXY=true
# COOKIE_SECURE=true
# NODE_ENV=production
# RATE_LIMIT_ENABLED=true

# --- Local Docker dev (no Caddy) ---
# COOKIE_SECURE=false
# Publish only on loopback; docker-compose maps 127.0.0.1:HOST_PORT -> container.
# HOST_PORT=3000

# Optional rate limit overrides (defaults: global 300/15m, auth 10/15m, expensive 60/15m, upload 5/h)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_EXPENSIVE_MAX=60
# RATE_LIMIT_UPLOAD_MAX=5

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
